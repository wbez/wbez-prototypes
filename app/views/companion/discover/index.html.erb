<% content_for :title, "Discover" %>

<%= render "companion/shared/topbar", title: "Discover" %>

<div class="cp-sectionhead cp-sectionhead--tight">
  <h2>Podcasts</h2>
  <span class="cp-tiny">Sort follows the show type</span>
</div>

<div class="cp-grid">
  <% @podcasts.each do |podcast| %>
    <article class="cp-pod">
      <div class="cp-pod__cover" style="background: <%= podcast[:color] %>"><%= podcast[:name] %></div>
      <div class="cp-pod__meta">
        <h3><%= podcast[:name] %></h3>
        <div class="cp-tiny"><%= podcast[:kind] %></div>
        <div class="cp-tiny"><%= podcast[:order] %></div>
        <button type="button" class="cp-follow" data-act="follow" data-name="<%= podcast[:name] %>" data-follow aria-pressed="false">Follow</button>
      </div>
    </article>
  <% end %>
</div>
<p class="cp-tiny cp-pad">Placeholder shows. Podcasts aren't part of the recordings.</p>
