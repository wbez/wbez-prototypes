<% content_for :title, "Search" %>

<div data-controller="search" data-search-index-url-value="<%= companion_search_index_path %>">
  <header class="cp-navbar cp-navbar--search">
    <form class="cp-searchbox" role="search" data-action="submit->search#submit">
      <%= ferris_icon "search", size: 18 %>
      <input type="search" name="q" placeholder="Search what you heard" autofocus autocomplete="off"
             aria-label="Search transcripts" data-search-target="input" data-action="input->search#queue">
    </form>
    <%= link_to "Cancel", companion_listen_path, class: "cp-small cp-navbar__cancel" %>
  </header>

  <div data-search-target="results" aria-live="polite">
    <p class="cp-empty">Search words spoken on air, like a name, a place or a topic.<br><br>Results jump to the exact moment.</p>
  </div>
</div>
